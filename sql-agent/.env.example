# ============================================================
# 配置模板：复制为 .env 并填入真实值
#   copy .env.example .env
# ============================================================

# ---------- PostgreSQL ----------
PG_HOST=192.168.10.101
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=<your-password>

# 两库隔离
PG_DB_LEDGER=agent_sql
PG_DB_BIZ=cs_v1

# 表目录（智能体关于「库里有什么」的唯一依据）
#   留空 = 用随项目发布的 config/tables.json
#   换库 / 换租户 / 换环境时指到别的文件即可，代码不用动
TABLES_FILE=

# 受限执行角色（只有业务表的 DML 权限）
RUNNER_USER=agent_sql_runner
RUNNER_PASSWORD=<runner-password>

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
STRUCTURED_METHOD=function_calling

# ---------- 运行开关 ----------
LLM_MODE=deepseek
MAX_ROUNDS=3
LEASE_SECONDS=300
USE_CHECKPOINTER=on

# ---------- 执行沙箱 ----------
MAX_ROWS=500
STATEMENT_TIMEOUT_MS=5000
CONFIRM_ROW_THRESHOLD=1000
