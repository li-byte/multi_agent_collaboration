# ============================================================
# 配置模板：复制为 .env 并填入真实值
#   copy .env.example .env
# ============================================================

# ---------- PostgreSQL ----------
PG_HOST=192.168.10.101
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=<your-password>
PG_DB=agents

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek 不支持 response_format: json_schema，必须走 function calling
STRUCTURED_METHOD=function_calling

# ---------- 运行开关 ----------
LLM_MODE=deepseek       # deepseek=真实调用；mock=离线兜底
MAX_ROUNDS=3
LEASE_SECONDS=300
USE_CHECKPOINTER=on
